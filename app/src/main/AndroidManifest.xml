<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        TFLite library (2.14.0) & TFLite-Support (0.4.4) manifests tidak memiliki
        namespace yang valid di AGP 9+. Override merger agar build tidak gagal.
    -->
    <uses-sdk tools:overrideLibrary="org.tensorflow.lite,org.tensorflow.lite.support,org.tensorflow.lite.metadata" />

    <!-- SMS -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- Call Monitoring -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Overlay (floating Check this website button) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Foreground Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
        WAJIB sejak Android 14 untuk foreground service bertipe "microphone".
        Tanpa ini startForeground() melempar SecurityException, dan karena
        ProtectionFragment menyalakan ulang service tiap aplikasi dibuka,
        aplikasi terkunci dalam lingkaran crash begitu Call Protection
        pernah diaktifkan.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ai_project_singapore"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Accessibility Service for URL/Message Monitoring -->
        <service
            android:name=".PhishGuardService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- SMS Receiver -->
        <receiver
            android:name=".receiver.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Call Monitor Service -->
        <service
            android:name=".service.CallMonitorService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Warning Overlay Activity -->
        <activity
            android:name=".ui.WarningActivity"
            android:exported="false"
            android:theme="@style/Theme.Warning"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleInstance" />

        <!-- Check Website (AI Recon) — accessible from Android Share Sheet -->
        <activity
            android:name=".ui.CheckWebsiteActivity"
            android:exported="true"
            android:theme="@style/Theme.Warning"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleInstance">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Recon Result popup -->
        <activity
            android:name=".ui.ReconResultActivity"
            android:exported="false"
            android:theme="@style/Theme.Warning"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleInstance" />

        <!-- SMS & Chat Notification Interceptor (NotificationListenerService) -->
        <!-- Ganti notifikasi SMS/chat phishing dengan peringatan kustom -->
        <service
            android:name=".service.SmsNotificationInterceptorService"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- FileProvider untuk share CSV laporan aktivitas -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>