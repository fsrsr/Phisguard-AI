<?xml version="1.0" encoding="utf-8"?>
<!-- Popup hasil recon — struktur mirip WarningActivity v1.0 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="16dp"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_warning_card"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Icon container -->
            <FrameLayout
                android:id="@+id/iconReconContainer"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_icon_circle_risk">

                <ImageView
                    android:id="@+id/ivReconIcon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/recon_title"
                    android:src="@android:drawable/ic_dialog_info"
                    app:tint="@color/primary" />
            </FrameLayout>

            <!-- Risk badge -->
            <TextView
                android:id="@+id/tvReconBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_risk_badge"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="@string/risk_medium"
                android:textColor="@color/warning_dark"
                android:textSize="11sp" />

            <!-- Title -->
            <TextView
                android:id="@+id/tvReconTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="@string/recon_title"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <!-- Domain -->
            <TextView
                android:id="@+id/tvReconDomain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="middle"
                android:fontFamily="monospace"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="@color/warning_dark"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="example-suspicious.com" />

            <!-- Summary -->
            <TextView
                android:id="@+id/tvReconSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                tools:text="Situs ini menunjukkan indikator phishing." />

            <!-- Confidence meter -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:text="@string/risk_meter_label"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp" />

                <ProgressBar
                    android:id="@+id/pbReconConfidence"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="50"
                    android:progressTint="@color/primary"
                    android:progressBackgroundTint="@color/divider" />

                <TextView
                    android:id="@+id/tvReconConfidence"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="72%" />
            </LinearLayout>

            <!-- URL -->
            <TextView
                android:id="@+id/tvReconUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_url_box"
                android:ellipsize="middle"
                android:fontFamily="monospace"
                android:maxLines="3"
                android:padding="12dp"
                android:textColor="@color/text_secondary"
                android:textIsSelectable="true"
                android:textSize="11sp"
                tools:text="https://example-suspicious.com/login" />

            <!-- Findings header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/recon_findings_title"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <!-- Findings list -->
            <LinearLayout
                android:id="@+id/containerFindings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <!-- SE indicators header -->
            <TextView
                android:id="@+id/tvSeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/recon_se_title"
                android:textColor="@color/warning_dark"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- SE indicators list -->
            <LinearLayout
                android:id="@+id/containerSeIndicators"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- Close button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReconClose"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minHeight="52dp"
                android:text="@string/recon_btn_close"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/primary"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
